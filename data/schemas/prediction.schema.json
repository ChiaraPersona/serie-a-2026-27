{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronostico partita Serie A",
  "type": "object",
  "required": ["matchId", "engineVersion", "probabilities", "exactScores", "verdict", "confidence", "surprise", "market", "dataQuality"],
  "properties": {
    "matchId": { "type": "string" },
    "engineVersion": { "type": "string" },
    "status": { "enum": ["preliminary", "ready", "archived"] },
    "probabilities": { "type": "object" },
    "exactScores": { "type": "array", "minItems": 3, "maxItems": 3 },
    "verdict": { "type": "object" },
    "confidence": { "type": "object" },
    "surprise": { "type": "object" },
    "market": { "type": "object" },
    "dataQuality": { "type": "object" }
  }
}
