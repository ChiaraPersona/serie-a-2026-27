{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronostico partita Serie A",
  "type": "object",
  "required": ["matchId", "engineVersion", "probabilities", "expectedGoals", "headToHead", "exactScores", "scoreForecast", "scoreProfile", "verdict", "confidence", "surprise", "matchProjection", "teamProjections", "likelyBooked", "scenarios", "marketComparison", "recommendations", "combinations", "playerMarkets", "market", "dataQuality"],
  "properties": {
    "matchId": { "type": "string" },
    "engineVersion": { "type": "string" },
    "status": { "enum": ["preliminary", "ready", "archived"] },
    "probabilities": { "type": "object" },
    "expectedGoals": { "type": "object" },
    "headToHead": { "type": "object" },
    "exactScores": { "type": "array", "minItems": 3, "maxItems": 3 },
    "scoreForecast": { "type": "object" },
    "scoreProfile": { "type": "object" },
    "modelValidation": { "type": "object" },
    "verdict": { "type": "object" },
    "confidence": { "type": "object" },
    "surprise": { "type": "object" },
    "matchProjection": { "type": "object" },
    "teamProjections": { "type": "array", "minItems": 2, "maxItems": 2 },
    "likelyBooked": { "type": "array", "minItems": 5, "maxItems": 5 },
    "scenarios": { "type": "array", "minItems": 3, "maxItems": 3 },
    "marketComparison": { "type": "array", "minItems": 16 },
    "recommendations": { "type": "object" },
    "combinations": { "type": "array" },
    "playerMarkets": { "type": "object" },
    "market": { "type": "object" },
    "dataQuality": { "type": "object" }
  }
}
