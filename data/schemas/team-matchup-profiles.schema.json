{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profili matchup squadra Serie A",
  "type": "object",
  "required": ["schemaVersion", "competition", "season", "generatedAt", "methodology", "coverage", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "competition": { "const": "serie-a" },
    "season": { "const": "2026-27" },
    "coverage": {
      "type": "object",
      "required": ["teams", "teamIds", "scope"],
      "properties": {
        "teams": { "type": "integer", "minimum": 1, "maximum": 20 },
        "teamIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scope": { "type": "string" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["teamId", "season", "sampleSize", "historicalBaseline", "currentSeason", "shotDefense", "vulnerabilities", "discipline", "corners", "volatility", "confidence", "dataQuality", "modelPolicy", "evidence"]
      }
    }
  }
}
