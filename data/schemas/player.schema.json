{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serie A player",
  "type": "object",
  "required": [
    "id",
    "name",
    "currentTeam",
    "currentSeason",
    "role",
    "detailedRole",
    "status",
    "marketValue",
    "previousSeason",
    "sources",
    "dataQuality"
  ],
  "properties": {
    "detailedRole": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "confermato",
        "nuovo acquisto",
        "prestito",
        "rientro dal prestito",
        "primavera",
        "da verificare"
      ]
    },
    "marketValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "amountEur",
            "currency",
            "provider",
            "retrievedAt",
            "sourceUrl"
          ]
        }
      ]
    },
    "previousSeason": {
      "type": "object",
      "required": [
        "season",
        "entries",
        "totals",
        "totalsByCompetition"
      ]
    }
  }
}
